<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF9F3">

    <!-- Decorative warm peach blob top-right -->
    <View
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-30dp"
        android:layout_marginEnd="-60dp"
        android:background="@drawable/bg_decorative_orange_blob" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Logo: left-aligned -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="22dp"
                android:paddingTop="42dp">

                <include
                    android:id="@+id/logoLayout"
                    layout="@layout/layout_apila_logo" />
            </LinearLayout>

            <!-- Headlines + Subtitle + Indicators -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingTop="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Community\nPrograms."
                    android:textColor="#101828"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="1.05"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stronger\nParticipation."
                    android:textColor="#F45113"
                    android:textSize="34sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false"
                    android:lineSpacingMultiplier="1.05"
                    android:letterSpacing="-0.02" />

                <TextView
                    android:id="@+id/tvSubtitle"
                    android:layout_width="200dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Join barangay programs and be part of a safer, healthier, and stronger Lapasan."
                    android:textColor="#667085"
                    android:textSize="13sp"
                    android:lineSpacingExtra="3dp" />

                <!-- Page indicators -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="28dp"
                        android:layout_height="7dp"
                        android:background="@drawable/bg_dot_active" />

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_dot_inactive" />

                    <View
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:layout_marginStart="7dp"
                        android:background="@drawable/bg_dot_inactive" />
                </LinearLayout>

            </LinearLayout>

            <!-- Landscape illustration: full-width edge-to-edge -->
            <ImageView
                android:id="@+id/ivRiverIllustration"
                android:layout_width="match_parent"
                android:layout_height="240dp"
                android:layout_marginTop="12dp"
                android:scaleType="centerCrop"
                android:src="@drawable/illustration_lapasan_river"
                android:contentDescription="Barangay Lapasan Landscape" />

            <!-- Bottom white card: full-width, rounded top corners only -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-26dp"
                android:background="@drawable/bg_white_card_top_rounded"
                android:orientation="vertical"
                android:paddingStart="24dp"
                android:paddingTop="26dp"
                android:paddingEnd="24dp"
                android:paddingBottom="14dp"
                android:elevation="6dp">

                <!-- 3 feature items -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp">

                    <!-- Join Programs -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_feature_circle">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_feature_community"
                                app:tint="#F45113"
                                android:contentDescription="Community" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Join\nPrograms"
                            android:gravity="center"
                            android:textColor="#101828"
                            android:textSize="12sp"
                            android:lineSpacingExtra="1dp" />
                    </LinearLayout>

                    <!-- Stay Informed -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_feature_circle">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_feature_clipboard"
                                app:tint="#F45113"
                                android:contentDescription="Clipboard" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Stay\nInformed"
                            android:gravity="center"
                            android:textColor="#101828"
                            android:textSize="12sp"
                            android:lineSpacingExtra="1dp" />
                    </LinearLayout>

                    <!-- Make a Difference -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="vertical">

                        <FrameLayout
                            android:layout_width="52dp"
                            android:layout_height="52dp"
                            android:background="@drawable/bg_feature_circle">

                            <ImageView
                                android:layout_width="26dp"
                                android:layout_height="26dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_feature_chart"
                                app:tint="#F45113"
                                android:contentDescription="Chart" />
                        </FrameLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Make a\nDifference"
                            android:gravity="center"
                            android:textColor="#101828"
                            android:textSize="12sp"
                            android:lineSpacingExtra="1dp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Get Started button -->
                <RelativeLayout
                    android:id="@+id/btnGetStarted"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:background="@drawable/bg_button_orange"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:text="Get Started"
                        android:textColor="#FFFFFF"
                        android:textSize="16.5sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="22dp"
                        android:src="@drawable/ic_arrow_forward"
                        app:tint="#FFFFFF"
                        android:contentDescription="Arrow" />
                </RelativeLayout>

                <!-- Footer: Already have an account? Log In -->
                <LinearLayout
                    android:id="@+id/layoutLoginFooter"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="6dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:clickable="true"
                    android:focusable="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Already have an account?  "
                        android:textColor="#475467"
                        android:textSize="13.5sp" />

                    <TextView
                        android:id="@+id/tvFooterLogin"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Log In"
                        android:textColor="#F45113"
                        android:textSize="13.5sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</FrameLayout>
