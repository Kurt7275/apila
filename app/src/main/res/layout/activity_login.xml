<?xml version="1.0" encoding="utf-8"?>
<!--
    LOGIN — "Scene + Sheet" design
    ─────────────────────────────
    Top 42%  → Scenic Lapasan illustration fills edge-to-edge (statusbar bleeds through)
    Logo pill → Floats top-left on the scene
    White sheet → 32dp rounded top corners, slides up & overlaps illustration by ~60dp
    Form     → Inside the white sheet, clean and breathable
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_background"
    android:fitsSystemWindows="false">

    <!-- ══════════════════════════════════════════
         SCENE LAYER: Lapasan illustration fills top
         ══════════════════════════════════════════ -->
    <ImageView
        android:id="@+id/ivSceneHero"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_gravity="top"
        android:scaleType="centerCrop"
        android:src="@drawable/illustration_lapasan_hero"
        android:contentDescription="Barangay Lapasan scenic view" />

    <!-- Warm gradient overlay: top of image has soft tint for readability -->
    <View
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_scene_to_white_fade"
        android:rotation="180" />

    <!-- Bottom fade: illustration dissolves into the white sheet -->
    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="top"
        android:layout_marginTop="140dp"
        android:background="@drawable/bg_scene_to_white_fade" />

    <!-- ══════════════════════════════════════════
         LOGO PILL: top-left, floats on the scene
         ══════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="20dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_logo_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_apila_pin"
            android:contentDescription="APILA pin logo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="APILA"
                android:textColor="#F45113"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Barangay Lapasan, CDO"
                android:textColor="#7A5540"
                android:textSize="9.5sp"
                android:letterSpacing="0.04" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══════════════════════════════════════════
         WHITE SHEET: overlaps illustration from ~200dp
         ══════════════════════════════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="200dp"
        android:background="@drawable/bg_sheet_white"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="36dp"
            android:paddingEnd="28dp"
            android:paddingBottom="40dp">

            <!-- ── HEADER ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Welcome back."
                android:textColor="#0F172A"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="-0.015" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Log in to your APILA resident account."
                android:textColor="#64748B"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp" />

            <!-- ── EMAIL FIELD ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="Email address"
                android:textColor="#374151"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_auth">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/ic_mail_outline"
                    android:contentDescription="Email icon"
                    app:tint="#94A3B8" />

                <EditText
                    android:id="@+id/etEmail"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="48dp"
                    android:layout_marginEnd="12dp"
                    android:background="@null"
                    android:hint="your@email.com"
                    android:textColorHint="#94A3B8"
                    android:textColor="#0F172A"
                    android:textSize="14.5sp"
                    android:inputType="textEmailAddress"
                    android:imeOptions="actionNext"
                    android:singleLine="true" />
            </FrameLayout>

            <!-- ── PASSWORD FIELD ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Password"
                android:textColor="#374151"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_auth">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/ic_lock_outline"
                    android:contentDescription="Password icon"
                    app:tint="#94A3B8" />

                <EditText
                    android:id="@+id/etPassword"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="48dp"
                    android:layout_marginEnd="52dp"
                    android:background="@null"
                    android:hint="Enter your password"
                    android:textColorHint="#94A3B8"
                    android:textColor="#0F172A"
                    android:textSize="14.5sp"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"
                    android:singleLine="true" />

                <!-- Show/hide password toggle -->
                <ImageView
                    android:id="@+id/ivPasswordToggle"
                    android:layout_width="44dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end|center_vertical"
                    android:padding="12dp"
                    android:src="@drawable/ic_close"
                    android:contentDescription="Toggle password visibility"
                    android:clickable="true"
                    android:focusable="true"
                    app:tint="#94A3B8" />
            </FrameLayout>

            <!-- ── FORGOT PASSWORD ── -->
            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="2dp"
                android:padding="4dp"
                android:text="Forgot password?"
                android:textColor="#F45113"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- ── LOADING INDICATOR ── -->
            <ProgressBar
                android:id="@+id/loginProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="6dp"
                android:indeterminate="true"
                android:indeterminateTint="#F45113"
                android:visibility="gone" />

            <!-- ── LOG IN BUTTON ── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="24dp"
                android:text="Log In"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                android:backgroundTint="#F45113"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd"
                app:iconPadding="8dp"
                app:iconSize="20dp"
                app:iconTint="@color/white"
                app:elevation="0dp"
                app:rippleColor="#40FFFFFF" />

            <!-- ── DIVIDER ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#EEF0F4" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:text="or"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"
                    android:background="#EEF0F4" />
            </LinearLayout>

            <!-- ── GOOGLE SIGN IN ── -->
            <LinearLayout
                android:id="@+id/btnGoogleSignIn"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_btn_google_auth"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_google_logo"
                    android:contentDescription="Google" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Continue with Google"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- ── DEMO SHORTCUTS ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/btnQuickResident"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_demo_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Demo Resident"
                        android:textColor="#C04A0D"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnQuickAdmin"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_google_auth"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Demo Admin"
                        android:textColor="#7C3400"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── REGISTER FOOTER ── -->
            <LinearLayout
                android:id="@+id/layoutRegisterFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New to Lapasan? "
                    android:textColor="#94A3B8"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvFooterRegister"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Create account"
                    android:textColor="#F45113"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</FrameLayout>
