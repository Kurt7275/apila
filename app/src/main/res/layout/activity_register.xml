<?xml version="1.0" encoding="utf-8"?>
<!--
    REGISTER — Native Mobile "Scene + Sheet" Design
    Matches LoginActivity hero proportion exactly (260dp centerCrop + 200dp sheet overlap)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/warm_background"
    android:fitsSystemWindows="false">

    <!-- ══════════════════════════════════════════
         SCENE LAYER: Full-width edge-to-edge Lapasan illustration
         ══════════════════════════════════════════ -->
    <ImageView
        android:id="@+id/ivSceneHero"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_gravity="top"
        android:scaleType="centerCrop"
        android:src="@drawable/illustration_lapasan_hero"
        android:contentDescription="Barangay Lapasan scenic view" />

    <!-- Top fade for status bar cleanliness -->
    <View
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_gravity="top"
        android:background="@drawable/bg_scene_to_white_fade"
        android:rotation="180" />

    <!-- Bottom fade: illustration dissolves into the white sheet -->
    <View
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_gravity="top"
        android:layout_marginTop="140dp"
        android:background="@drawable/bg_scene_to_white_fade" />

    <!-- ══════════════════════════════════════════
         LOGO PILL: top-left floating badge
         ══════════════════════════════════════════ -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="20dp"
        android:layout_marginTop="48dp"
        android:background="@drawable/bg_logo_pill"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="28dp"
            android:src="@drawable/ic_apila_pin"
            android:contentDescription="APILA pin logo" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="APILA"
                android:textColor="#F45113"
                android:textSize="15sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Barangay Lapasan, CDO"
                android:textColor="#7A5540"
                android:textSize="9.5sp"
                android:letterSpacing="0.04" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══════════════════════════════════════════
         WHITE SHEET: Overlaps illustration from 200dp
         ══════════════════════════════════════════ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="200dp"
        android:background="@drawable/bg_sheet_white"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="36dp"
            android:paddingEnd="28dp"
            android:paddingBottom="40dp">

            <!-- ── HEADER ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create an account."
                android:textColor="#0F172A"
                android:textSize="28sp"
                android:textStyle="bold"
                android:letterSpacing="-0.015" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Join community initiatives in Barangay Lapasan."
                android:textColor="#64748B"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp" />

            <!-- ── FULL NAME ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Full name"
                android:textColor="#374151"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_auth">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/ic_user_outline"
                    android:contentDescription="Name"
                    app:tint="#94A3B8" />

                <EditText
                    android:id="@+id/etFullName"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="48dp"
                    android:layout_marginEnd="12dp"
                    android:background="@null"
                    android:hint="Maria Santos"
                    android:textColorHint="#94A3B8"
                    android:textColor="#0F172A"
                    android:textSize="14.5sp"
                    android:inputType="textPersonName|textCapWords"
                    android:imeOptions="actionNext"
                    android:singleLine="true" />
            </FrameLayout>

            <!-- ── EMAIL + MOBILE ROW ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email address"
                        android:textColor="#374151"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_auth">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="14dp"
                            android:src="@drawable/ic_mail_outline"
                            android:contentDescription="Email"
                            app:tint="#94A3B8" />

                        <EditText
                            android:id="@+id/etEmail"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="40dp"
                            android:layout_marginEnd="8dp"
                            android:background="@null"
                            android:hint="maria@email.com"
                            android:textColorHint="#94A3B8"
                            android:textColor="#0F172A"
                            android:textSize="13.5sp"
                            android:inputType="textEmailAddress"
                            android:imeOptions="actionNext"
                            android:singleLine="true" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mobile number"
                        android:textColor="#374151"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_auth">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="14dp"
                            android:src="@drawable/ic_phone_outline"
                            android:contentDescription="Mobile"
                            app:tint="#94A3B8" />

                        <EditText
                            android:id="@+id/etPhone"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="40dp"
                            android:layout_marginEnd="8dp"
                            android:background="@null"
                            android:hint="0917 123 4567"
                            android:textColorHint="#94A3B8"
                            android:textColor="#0F172A"
                            android:textSize="13.5sp"
                            android:inputType="phone"
                            android:imeOptions="actionNext"
                            android:singleLine="true" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ── PASSWORD + CONFIRM ROW ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Password"
                        android:textColor="#374151"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_auth">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="14dp"
                            android:src="@drawable/ic_lock_outline"
                            android:contentDescription="Password"
                            app:tint="#94A3B8" />

                        <EditText
                            android:id="@+id/etPassword"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="40dp"
                            android:layout_marginEnd="8dp"
                            android:background="@null"
                            android:hint="min. 6 chars"
                            android:textColorHint="#94A3B8"
                            android:textColor="#0F172A"
                            android:textSize="13.5sp"
                            android:inputType="textPassword"
                            android:imeOptions="actionNext"
                            android:singleLine="true" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Confirm"
                        android:textColor="#374151"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="54dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_input_auth">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="center_vertical|start"
                            android:layout_marginStart="14dp"
                            android:src="@drawable/ic_lock_outline"
                            android:contentDescription="Confirm"
                            app:tint="#94A3B8" />

                        <EditText
                            android:id="@+id/etConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="40dp"
                            android:layout_marginEnd="8dp"
                            android:background="@null"
                            android:hint="re-enter"
                            android:textColorHint="#94A3B8"
                            android:textColor="#0F172A"
                            android:textSize="13.5sp"
                            android:inputType="textPassword"
                            android:imeOptions="actionNext"
                            android:singleLine="true" />
                    </FrameLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ── ADDRESS / PUROK ── -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Purok / Street address"
                android:textColor="#374151"
                android:textSize="13sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input_auth">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center_vertical|start"
                    android:layout_marginStart="16dp"
                    android:src="@drawable/ic_location_outline"
                    android:contentDescription="Address"
                    app:tint="#94A3B8" />

                <EditText
                    android:id="@+id/etAddress"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginStart="48dp"
                    android:layout_marginEnd="12dp"
                    android:background="@null"
                    android:hint="Purok 2 – Lapasan Proper, CDO"
                    android:textColorHint="#94A3B8"
                    android:textColor="#0F172A"
                    android:textSize="14sp"
                    android:inputType="textPostalAddress|textCapWords"
                    android:imeOptions="actionDone"
                    android:singleLine="true" />
            </FrameLayout>

            <!-- ── PRIVACY BANNER ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_info_banner"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_lock_outline"
                    app:tint="#92400E" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:text="Your information is used strictly for official Barangay Lapasan program notifications."
                    android:textColor="#92400E"
                    android:textSize="12sp"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

            <!-- ── LOADING INDICATOR ── -->
            <ProgressBar
                android:id="@+id/registerProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="12dp"
                android:indeterminate="true"
                android:indeterminateTint="#F45113"
                android:visibility="gone" />

            <!-- ── CREATE ACCOUNT BUTTON ── -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitRegister"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="20dp"
                android:text="Create Account"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:letterSpacing="0.01"
                android:backgroundTint="#F45113"
                app:cornerRadius="16dp"
                app:icon="@drawable/ic_arrow_forward"
                app:iconGravity="textEnd"
                app:iconPadding="8dp"
                app:iconSize="20dp"
                app:iconTint="@color/white"
                app:elevation="0dp"
                app:rippleColor="#40FFFFFF" />

            <!-- ── FOOTER: BACK TO LOGIN ── -->
            <LinearLayout
                android:id="@+id/layoutLoginFooter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:clickable="true"
                android:focusable="true">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Already have an account? "
                    android:textColor="#94A3B8"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvFooterLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Log in"
                    android:textColor="#F45113"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Hidden view for binding safety -->
            <View
                android:id="@+id/btnBack"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </LinearLayout>
    </ScrollView>

</FrameLayout>
